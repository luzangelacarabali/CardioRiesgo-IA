<mxfile host="app.diagrams.net"><diagram name="Pipeline Azure ML" id="p1"><mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="900" pageHeight="1360" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ds" value="&lt;b&gt;Framingham Heart Study (Kaggle)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Data asset CSV, ~4.000 pacientes&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#444441;" vertex="1" parent="1"><mxGeometry x="270" y="40" width="300" height="50" as="geometry"/></mxCell><mxCell id="sel" value="&lt;b&gt;Select Columns in Dataset&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;9 variables + etiqueta TenYearCHD&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#444441;" vertex="1" parent="1"><mxGeometry x="270" y="120" width="300" height="50" as="geometry"/></mxCell><mxCell id="cmd" value="&lt;b&gt;Clean Missing Data&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Mediana en glucose, totChol, BMI, cigsPerDay&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#444441;" vertex="1" parent="1"><mxGeometry x="270" y="200" width="300" height="50" as="geometry"/></mxCell><mxCell id="meta" value="&lt;b&gt;Edit Metadata&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;currentSmoker y diabetes categóricas&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#444441;" vertex="1" parent="1"><mxGeometry x="270" y="280" width="300" height="50" as="geometry"/></mxCell><mxCell id="norm" value="&lt;b&gt;Normalize Data&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ZScore en variables numéricas&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=12;fillColo